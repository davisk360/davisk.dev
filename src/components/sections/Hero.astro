---
import { ArrowDownRight } from 'lucide-react';
---

<section class="hero-section" aria-labelledby="hero-title">
  <div class="hero-orb" aria-hidden="true"></div>
  <div class="hero-guide" aria-hidden="true"></div>

  <div class="hero-inner content-shell reveal">
    <div class="monogram" aria-hidden="true">KD</div>
    <p class="eyebrow hero-identity mono-text">KELLY DAVIS / HONOLULU / OPEN TO WORK</p>
    <h1 class="hero-title" id="hero-title">
      I design systems.{' '}<br />
      AI builds them.{' '}<br />
      <span class="hero-highlight">I ship them.</span>
    </h1>
    <p class="hero-lede">
      Product Engineer. AI-augmented developer. System design, detailed specs, deployed codebases.
    </p>
    <div class="hero-actions">
      <a class="action-link action-link--primary focus-ring" href="#work">
        <span>View my work</span>
        <ArrowDownRight size={15} strokeWidth={2} aria-hidden="true" />
      </a>
      <a class="action-link action-link--secondary focus-ring" href="#contact">Get in touch</a>
    </div>
    <div class="hero-process mono-text" aria-label="Process: spec first, AI builds, verify, ship">
      <span>SPEC FIRST</span>
      <span class="process-dot" aria-hidden="true">·</span>
      <span>AI BUILDS</span>
      <span class="process-dot" aria-hidden="true">·</span>
      <span>VERIFY</span>
      <span class="process-dot" aria-hidden="true">·</span>
      <span>SHIP</span>
    </div>
  </div>
</section>
